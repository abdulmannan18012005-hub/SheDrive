{
  "expo": {
    "name": "SheDrive",
    "slug": "shedrive",
    "scheme": "shedrive",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "assets/*"
    ],
    "splash": {
      "image": "./assets/icon.png",
      "backgroundColor": "#4A2060",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lahore.pinkrides"
    },
    "android": {
      "package": "com.lahore.pinkrides",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCsOFBXAEmYvsV7SG6-VKK4cjyH9NoS7vs"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A2060"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "ACCESS_BACKGROUND_LOCATION"
      ],
      "notification": {
        "channel": {
          "ride_alerts": {
            "name": "Ride Alerts",
            "description": "Notifications for ride updates, bids, and driver arrivals",
            "importance": "high",
            "sound": true,
            "vibrate": true
          },
          "admin_broadcasts": {
            "name": "Platform Broadcasts",
            "description": "Platform news, community updates, and announcements",
            "importance": "high",
            "sound": true
          },
          "chatMessages": {
            "name": "Chat Messages",
            "description": "Notifications for in-ride chat messages",
            "importance": "default",
            "sound": true
          },
          "safetyAlerts": {
            "name": "Safety Alerts",
            "description": "Emergency SOS and safety notifications",
            "importance": "high",
            "sound": true,
            "vibrate": true
          }
        }
      }
    },
    "updates": {
      "url": "https://u.expo.dev/984107313094"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "984107313094"
      }
    }
  }
}
