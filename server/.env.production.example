# SheDrive Backend - Production Environment Template
# Copy this file to .env and configure with your actual production secrets on Render.com

# Server Environment
PORT=3000
NODE_ENV=production

# Supabase PostgreSQL Connection
# Direct Connection Pooler URL (Port 5432 / 6543)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# JWT Secret for Mobile & Admin Portal authentication
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=30d

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Supabase Service Role (For admin operations / password reset email fallback)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Password Reset Deep Link Scheme
PASSWORD_RESET_REDIRECT_URL=shedrive://reset-password

# Gmail SMTP Configuration for Real-time OTP & Password Reset Delivery
GMAIL_USER=your_support_email@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_gmail_app_password

# CORS Allowed Origin (e.g., your InfinityFree Admin Portal domain)
# For testing: * | For production: https://yourdomain.com,https://admin.yourdomain.com
CLIENT_URL=*
