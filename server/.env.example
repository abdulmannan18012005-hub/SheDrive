# SheDrive Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (REQUIRED)
DATABASE_URL=postgresql://user:password@host:port/database

# JWT Configuration (REQUIRED - use a strong random secret)
JWT_SECRET=your-strong-random-jwt-secret-here

# Supabase Configuration (REQUIRED for password reset)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Firebase Admin Configuration (REQUIRED for FCM)
# Either provide firebase-service-account.json file OR set these env vars:
FIREBASE_PROJECT_ID=lahore-pink-rides
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lahore-pink-rides.iam.gserviceaccount.com

# Cloudinary Configuration (REQUIRED for image uploads)
CLOUDINARY_CLOUD_NAME=shedrive
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Gmail SMTP Configuration (REQUIRED for OTP and password reset emails)
GMAIL_USER=SheDrive.Support@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# Gmail OAuth2 Configuration (Optional - for production email delivery)
# If not provided, SMTP will be used as fallback
GMAIL_CLIENT_ID=your-oauth2-client-id
GMAIL_CLIENT_SECRET=your-oauth2-client-secret
GMAIL_REFRESH_TOKEN=your-oauth2-refresh-token

# CORS Configuration
# Comma-separated list of allowed origins for API and Socket.io
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:19006,https://shedrive.onrender.com

# Application Configuration
CLIENT_URL=https://shedrive.com
PASSWORD_RESET_REDIRECT_URL=shedrive://reset-password

# GitHub APK Download URL (Optional - for app download endpoint)
GITHUB_APK_DOWNLOAD_URL=https://github.com/abdulmannan18012005-hub/SheDrive/releases/latest/download/SheDrive.apk
